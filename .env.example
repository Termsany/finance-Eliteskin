# ===== المتابعة المالية v2 =====
# انسخ الملف ده لـ .env على السيرفر واملأ القيم. ما ترفعش .env على Git.

# كلمة المرور الأولى للدخول — بعد ما تدخل غيّرها من صفحة الإعدادات (الجديدة بتتحفظ مشفّرة وبتلغي دي)
APP_PASSWORD=change-me-strong-password

# سر توقيع الجلسات وتشفير المفاتيح (نص عشوائي طويل — ما تغيّروش بعد التشغيل، وإلا المفاتيح المحفوظة هتحتاج تتكتب تاني)
SESSION_SECRET=change-me-to-a-long-random-string

# باسورد قاعدة البيانات (أي نص عشوائي — بين علامتين ' لو فيه علامة $)
POSTGRES_PASSWORD=change-me-db-password

# مكان ملف بيانات النسخة الأولى (اللي فيه db.json) عشان المصاريف والمفاتيح تتنقل تلقائياً
LEGACY_DATA_PATH=/opt/elite-finance/data

# (اختياري) دفترة والذكاء الاصطناعي — الأسهل تضيفهم من صفحة الإعدادات جوه البرنامج
DAFTRA_SUBDOMAIN=
DAFTRA_API_KEY=
DAFTRA_DOMAIN=daftra.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# كل كام دقيقة يتزامن مع دفترة (الافتراضي 60)
SYNC_EVERY_MINUTES=60
