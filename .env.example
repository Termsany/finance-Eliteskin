# ===== إعدادات برنامج المتابعة المالية =====
# انسخ هذا الملف إلى .env على السيرفر واملأ القيم. لا تضع .env في أي مكان عام.

# المنفذ الذي يعمل عليه السيرفر داخليًا (nginx يوجّه إليه)
PORT=3200

# كلمة مرور الدخول للبرنامج (غيّرها لكلمة قوية) — دي اللي هتسجّل بيها دخول
APP_PASSWORD=change-me-strong-password

# سر توقيع الجلسات (أي نص عشوائي طويل)
SESSION_SECRET=change-me-to-a-long-random-string

# العملة المعروضة
CURRENCY=ج.م

# ===== ربط دفترة والذكاء الاصطناعي =====
# الأسهل: سيبهم فاضيين هنا، وأضف المفاتيح من داخل البرنامج (صفحة الإعدادات) بعد الدخول.
# لو فضّلت تحطهم هنا بدل الواجهة، املأ القيم التالية (إعدادات الواجهة لها الأولوية):
DAFTRA_SUBDOMAIN=
DAFTRA_APIKEY=
DAFTRA_DOMAIN=daftara.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
