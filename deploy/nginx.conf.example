# إعداد Nginx — ضعه في /etc/nginx/sites-available/elite-finance ثم فعّله.
# غيّر finance.eliteskinsa.com للدومين/الساب دومين اللي تختاره.
server {
    listen 80;
    server_name finance.eliteskinsa.com;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# بعد التفعيل شغّل:  sudo certbot --nginx -d finance.eliteskinsa.com
# ليتحول الموقع تلقائيًا إلى HTTPS.
